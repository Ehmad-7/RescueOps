# Backend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ALLOWED_ORIGINS=http://localhost:3000
RUNS_DIR=/tmp/rescueops/runs
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=40
RUN_TIMEOUT_S=300
MAX_CONCURRENT_RUNS=2

# Frontend: NOT read from this file. Next.js only loads env files from frontend/,
# so set this in frontend/.env.local (local) or in the hosting provider (deployment).
# NEXT_PUBLIC_API_URL=http://localhost:8000
